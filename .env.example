# =============================================================================
# EduCloud LMS — Environment Variables (§23)
# Copy to .env and fill in real values. Never commit .env to the repo.
# =============================================================================

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ENVIRONMENT=production   # local | test | production
ALLOWED_HOSTS=

# All domain values derive from BASE_DOMAIN (§15.1, INV-114a)
BASE_DOMAIN=educloud.app
# Computed:
#   WORKSPACE_DOMAIN_SUFFIX = .{BASE_DOMAIN}
#   CORS_ALLOWED_ORIGIN_REGEXES derived from BASE_DOMAIN
#   CSRF_TRUSTED_ORIGINS derived from BASE_DOMAIN
#   SESSION_COOKIE_DOMAIN = .{BASE_DOMAIN}

# --- Database ---
DATABASE_URL=postgres://user:pass@localhost:5432/educloud

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_ENDPOINT=    # e.g. https://pub-xxx.r2.dev  (private bucket — leave blank)

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@educloud.app

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Security ---
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
SESSION_COOKIE_AGE=86400        # seconds (24 h)
PASSWORD_RESET_TIMEOUT=3600     # seconds (1 h)
VERIFICATION_TOKEN_EXPIRY=86400 # seconds (24 h)

# --- ClamAV (optional) ---
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# --- Rate limiting ---
LOGIN_THROTTLE_RATE=5/15m
API_THROTTLE_RATE=1000/hour

# --- Sentry (optional) ---
SENTRY_DSN=

# --- Storage mode ---
STORAGE_BACKEND=r2   # r2 | local  (local for dev/test)
SCANNER_BACKEND=clamav   # clamav | null | eicar_only

# --- Business settings (operator-adjustable) ---
DEFAULT_GRACE_PERIOD_DAYS=7
DEFAULT_RETENTION_DAYS=90
DEFAULT_UPLOAD_SIZE_LIMIT_MB=500
UPGRADE_MIN_CHARGE_EGP=1.00
UPGRADE_MIN_REMAINING_DAYS=3
PENDING_PAYMENT_REMINDER_INTERVAL_HOURS=48

# --- Celery visibility timeout (INV-112a) ---
CELERY_VISIBILITY_TIMEOUT=43200   # 12 h (must exceed longest expected task)
