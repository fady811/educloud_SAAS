          nullable: true
        title:
          type: string
          maxLength: 200
        instructions:
          type: string
        due_at:
          type: string
          format: date-time
          nullable: true
        max_score:
          type: integer
          maximum: 32767
          minimum: -32768
        allow_late:
          type: boolean
      required:
      - id
      - title
    AssignmentRequest:
      type: object
      properties:
        lesson:
          type: integer
          nullable: true
        group:
          type: integer
          nullable: true
        title:
          type: string
          minLength: 1
          maxLength: 200
        instructions:
          type: string
        due_at:
          type: string
          format: date-time
