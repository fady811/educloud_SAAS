          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
          nullable: true
        title:
          type: string
          maxLength: 200
        body_html:
          type: string
        is_pinned:
          type: boolean
        published_at:
          type: string
          format: date-time
          nullable: true
      required:
      - author
      - body_html
      - id
      - title
    AnnouncementRequest:
      type: object
      properties:
        author:
          type: integer
        scope:
          $ref: '#/components/schemas/ScopeEnum'
        target_id:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
          nullable: true
        title:
          type: string
          minLength: 1
          maxLength: 200
        body_html:
          type: string
          minLength: 1
        is_pinned:
          type: boolean
        published_at:
          type: string
          format: date-time
          nullable: true
      required:
      - author
      - body_html
      - title
    Assignment:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        lesson:
          type: integer
          nullable: true
